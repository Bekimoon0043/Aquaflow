{
  "contract": "aquaflow-golden-show",
  "version": 1,
  "description": "AF-NEXT-004 golden show. Shared by frontend parity tests (evaluateShowFrame.golden.test.js) and backend tests/test_show_frame.py. Expected values are hand-derived from the documented policies; light bytes are round(srgb x level x 255). Tolerance: 1/255 for levels, 1 for 8-bit bytes.",
  "tolerance": { "level": 0.00392156862745098, "byte": 1 },
  "fixtures": [
    { "id": "P1", "type": "pump", "kind": "pump", "name": "Main pump" },
    { "id": "V1", "type": "valve_solenoid", "kind": "valve", "name": "Jet valve" },
    { "id": "N1", "type": "nozzle_jet", "kind": "water", "name": "Centre jet" },
    { "id": "L1", "type": "light_uw_rgb_36w", "kind": "light", "name": "Light 1" },
    { "id": "L2", "type": "light_uw_rgb_36w", "kind": "light", "name": "Light 2" }
  ],
  "siemens": {
    "P1": { "kind": "pump", "index": 0, "max_percent": 40 },
    "V1": { "kind": "valve", "index": 0, "pump_id": "P1" },
    "L1": { "kind": "light", "index": 0 },
    "L2": { "kind": "light", "index": 1 }
  },
  "clips": [
    { "id": "c1", "fixtureId": "P1", "trackId": "P1-pump_speed", "type": "pump_speed", "name": "Pump ramp", "startTime": 0, "duration": 8, "value": 40, "fadeIn": 2, "fadeOut": 2, "curveType": "linear", "effects": [] },
    { "id": "c2", "fixtureId": "V1", "trackId": "V1-solenoid_open", "type": "solenoid_open", "name": "Valve open", "startTime": 0, "duration": 8, "value": 100, "fadeIn": 0, "fadeOut": 0, "curveType": "linear", "effects": [] },
    { "id": "c3", "fixtureId": "N1", "trackId": "N1-device_intensity", "type": "device_intensity", "name": "Jet rise", "startTime": 0, "duration": 4, "value": 100, "fadeIn": 1, "fadeOut": 0, "curveType": "linear", "color": "#65d9d0", "effects": [] },
    { "id": "c4", "fixtureId": "N1", "trackId": "N1-device_intensity", "type": "device_intensity", "name": "Jet settle (overlaps c3)", "startTime": 3, "duration": 3, "value": 60, "fadeIn": 0, "fadeOut": 1, "curveType": "linear", "color": "#529bff", "effects": [] },
    { "id": "c5", "fixtureId": "L1", "trackId": "L1-lighting_master", "type": "lighting_master", "name": "Amber", "startTime": 0, "duration": 8, "value": 80, "fadeIn": 2, "fadeOut": 0, "curveType": "linear", "color": "#ff8000", "effects": [] },
    { "id": "c6", "fixtureId": "L2", "trackId": "L2-lighting_master", "type": "lighting_master", "name": "Blue", "startTime": 1, "duration": 6, "value": 100, "fadeIn": 0, "fadeOut": 3, "curveType": "linear", "color": "#0040ff", "effects": [] },
    { "id": "c7", "fixtureId": "L2", "trackId": "L2-lighting_red", "type": "lighting_red", "name": "Red channel override", "startTime": 2, "duration": 2, "value": 50, "fadeIn": 0, "fadeOut": 0, "curveType": "linear", "effects": [] }
  ],
  "loop": { "startMs": 0, "endMs": 8000 },
  "checkpoints": [
    { "name": "start", "timeMs": 0, "opts": {},
      "expect": { "state": "playing", "levels": { "P1": 0, "V1": 1, "N1": 0, "L1": 0, "L2": 0 },
        "pumps": { "P1": 0 }, "valves": { "V1": true }, "lights": { "L1": [0, 0, 0], "L2": [0, 0, 0] } } },
    { "name": "fade-in midpoint", "timeMs": 1000, "opts": {},
      "expect": { "state": "playing", "levels": { "P1": 0.2, "V1": 1, "N1": 1, "L1": 0.4, "L2": 1 },
        "pumps": { "P1": 0.2 }, "valves": { "V1": true }, "lights": { "L1": [102, 51, 0], "L2": [0, 64, 255] } } },
    { "name": "fade boundary", "timeMs": 2000, "opts": {},
      "expect": { "state": "playing", "levels": { "P1": 0.4, "V1": 1, "N1": 1, "L1": 0.8, "L2": 1 },
        "pumps": { "P1": 0.4 }, "valves": { "V1": true }, "lights": { "L1": [204, 102, 0], "L2": [128, 0, 0] } } },
    { "name": "overlap (highest takes precedence)", "timeMs": 3500, "opts": {},
      "expect": { "state": "playing", "levels": { "P1": 0.4, "V1": 1, "N1": 1, "L1": 0.8, "L2": 1 },
        "pumps": { "P1": 0.4 }, "valves": { "V1": true }, "lights": { "L1": [204, 102, 0], "L2": [128, 0, 0] },
        "source": { "N1": "c3" }, "diagnostics": ["overlap"] } },
    { "name": "midpoint", "timeMs": 4000, "opts": {},
      "expect": { "state": "playing", "levels": { "P1": 0.4, "V1": 1, "N1": 0.6, "L1": 0.8, "L2": 1 },
        "pumps": { "P1": 0.4 }, "valves": { "V1": true }, "lights": { "L1": [204, 102, 0], "L2": [0, 64, 255] },
        "source": { "N1": "c4" } } },
    { "name": "fade-out midpoint", "timeMs": 5500, "opts": {},
      "expect": { "state": "playing", "levels": { "P1": 0.4, "V1": 1, "N1": 0.3, "L1": 0.8, "L2": 0.5 },
        "pumps": { "P1": 0.4 }, "valves": { "V1": true }, "lights": { "L1": [204, 102, 0], "L2": [0, 32, 128] } } },
    { "name": "pump fade-out", "timeMs": 7000, "opts": {},
      "expect": { "state": "playing", "levels": { "P1": 0.2, "V1": 1, "N1": 0, "L1": 0.8, "L2": 0 },
        "pumps": { "P1": 0.2 }, "valves": { "V1": true }, "lights": { "L1": [204, 102, 0], "L2": [0, 0, 0] } } },
    { "name": "show end (no loop)", "timeMs": 8000, "opts": {},
      "expect": { "state": "playing", "levels": { "P1": 0, "V1": 0, "N1": 0, "L1": 0, "L2": 0 },
        "pumps": { "P1": 0 }, "valves": { "V1": false }, "lights": { "L1": [0, 0, 0], "L2": [0, 0, 0] } } },
    { "name": "loop boundary", "timeMs": 8000, "opts": { "loop": { "startMs": 0, "endMs": 8000 } },
      "expect": { "state": "playing", "passIndex": 2, "levels": { "P1": 0, "V1": 1, "N1": 0, "L1": 0, "L2": 0 },
        "pumps": { "P1": 0 }, "valves": { "V1": true }, "lights": { "L1": [0, 0, 0], "L2": [0, 0, 0] } } },
    { "name": "second pass", "timeMs": 9000, "opts": { "loop": { "startMs": 0, "endMs": 8000 } },
      "expect": { "state": "playing", "passIndex": 2, "levels": { "P1": 0.2, "V1": 1, "N1": 1, "L1": 0.4, "L2": 1 },
        "pumps": { "P1": 0.2 }, "valves": { "V1": true }, "lights": { "L1": [102, 51, 0], "L2": [0, 64, 255] } } },
    { "name": "blackout", "timeMs": 4000, "opts": { "blackout": true },
      "expect": { "state": "blackout", "levels": { "P1": 0, "V1": 0, "N1": 0, "L1": 0, "L2": 0 },
        "pumps": { "P1": 0 }, "valves": { "V1": false }, "lights": { "L1": [0, 0, 0], "L2": [0, 0, 0] } } }
  ]
}
