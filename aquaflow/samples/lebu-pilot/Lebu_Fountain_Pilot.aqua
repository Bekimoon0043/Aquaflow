          "engineering.geometry.points",
          "engineering.params.width",
          "engineering.params.length",
          "engineering.geometry.source.extents",
          "engineering.depth_zones[0].points",
          "engineering.measurements"
        ],
        "method": "Each SPLINE is sampled as two rational quadratic Bezier halves from the DXF control points and weights (6 segments per half)."
