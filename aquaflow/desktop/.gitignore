# AquaFlow desktop — build & dependency artifacts (never committed).
# NOTE: gitignore does NOT support inline comments — a trailing "# …" becomes part of the
# pattern and silently disables it (that bug previously left dist/, web/ and
# resources/engine/ unignored). Keep every comment on its own line.
node_modules/
# electron-builder output (installers)
dist/
# copied Vite production build (regenerated by build:web)
web/
# PyInstaller output copied in (regenerated by build:engine)
resources/engine/
*.log
.DS_Store

# AF-PKG-005 — build/ here holds COMMITTED brand assets (icons, installer graphics),
# not build output. Re-include it (a parent .gitignore ignores build/).
!build/
!build/**
