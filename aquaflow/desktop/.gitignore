# AquaFlow desktop — build & dependency artifacts (never committed)
node_modules/
dist/               # electron-builder output (installers)
web/                # copied Vite production build (regenerated by build:web)
resources/engine/   # PyInstaller output copied in (regenerated by build:engine)
*.log
.DS_Store

# AF-PKG-005 — build/ here holds COMMITTED brand assets (icons, installer graphics),
# not build output. Re-include it (a parent .gitignore ignores build/).
!build/
!build/**
