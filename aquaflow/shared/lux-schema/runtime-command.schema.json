{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxcon.example/schemas/runtime-command.schema.json",
  "title": "Runtime Command",
  "type": "object",
  "required": ["command_id", "timestamp_us", "device_id", "action", "value", "safety_class"],
  "properties": {
    "command_id": { "type": "string" },
    "timestamp_us": { "type": "integer" },
    "device_id": { "type": "string" },
    "action": { "type": "string" },
    "value": { "type": "number" },
    "safety_class": { "type": "string", "enum": ["normal", "critical", "inhibit", "rollback"] }
  },
  "additionalProperties": false
}
