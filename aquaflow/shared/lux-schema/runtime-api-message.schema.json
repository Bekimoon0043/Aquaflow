{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxcon.example/schemas/runtime-api-message.schema.json",
  "title": "Runtime API Message",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "deploy_bundle",
        "arm_live",
        "play",
        "pause",
        "stop",
        "seek",
        "emergency_stop",
        "heartbeat",
        "fault",
        "telemetry",
        "ack"
      ]
    },
    "session_id": { "type": "string" },
    "bundle_id": { "type": "string" },
    "playhead_ms": { "type": "integer" },
    "payload": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
