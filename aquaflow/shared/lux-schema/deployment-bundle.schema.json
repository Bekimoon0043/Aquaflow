{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxcon.example/schemas/deployment-bundle.schema.json",
  "title": "Deployment Bundle",
  "type": "object",
  "required": ["bundle_id", "show_id", "runtime_target", "artifacts", "checksums", "safety_profile"],
  "properties": {
    "bundle_id": { "type": "string" },
    "show_id": { "type": "string" },
    "runtime_target": { "type": "string", "enum": ["industrial_pc", "embedded_controller", "offline_kiosk", "cloud_runtime"] },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "properties": {
          "path": { "type": "string" },
          "kind": { "type": "string" },
          "optional": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "checksums": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "safety_profile": { "type": "string" },
    "requires_operator_ack": { "type": "boolean" }
  },
  "additionalProperties": false
}
