{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxcon.example/schemas/runtime-session.schema.json",
  "title": "Runtime Session",
  "type": "object",
  "required": ["session_id", "mode", "transport", "bundle_id", "sync", "safety", "commands"],
  "properties": {
    "session_id": { "type": "string" },
    "mode": { "type": "string", "enum": ["design", "simulation", "live"] },
    "transport": { "type": "string", "enum": ["stopped", "armed", "playing", "paused", "fault", "emergency_stop"] },
    "bundle_id": { "type": "string" },
    "sync": {
      "type": "object",
      "required": ["source", "locked"],
      "properties": {
        "source": { "type": "string", "enum": ["internal", "ntp", "ptp", "smpte", "ltc", "mtc"] },
        "locked": { "type": "boolean" },
        "offset_us": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": ["state", "permit_live"],
      "properties": {
        "state": { "type": "string" },
        "permit_live": { "type": "boolean" },
        "active_faults": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "runtime-command.schema.json" }
    }
  },
  "additionalProperties": false
}
