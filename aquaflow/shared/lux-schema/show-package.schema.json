{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxcon.example/schemas/show-package.schema.json",
  "title": "Lux Show Package",
  "type": "object",
  "required": ["format", "show", "assets", "devices", "patch", "timeline", "compile"],
  "properties": {
    "format": {
      "type": "object",
      "required": ["extension", "version"],
      "properties": {
        "extension": { "type": "string", "enum": [".luxshow"] },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "show": {
      "type": "object",
      "required": ["id", "name", "duration_ms", "mode"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "duration_ms": { "type": "integer" },
        "mode": { "type": "string", "enum": ["design", "simulation", "live"] },
        "bpm": { "type": "number" },
        "sample_rate": { "type": "integer" },
        "loop": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" },
          "kind": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "devices": {
      "type": "array",
      "items": { "$ref": "device.schema.json" }
    },
    "patch": {
      "type": "object",
      "required": ["nodes", "connections"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "node.schema.json" }
        },
        "connections": {
          "type": "array",
          "items": { "$ref": "connection.schema.json" }
        }
      },
      "additionalProperties": false
    },
    "timeline": {
      "type": "array",
      "items": { "$ref": "track.schema.json" }
    },
    "safety_rules": {
      "type": "array",
      "items": { "$ref": "safety-rule.schema.json" }
    },
    "calibration_profile": {
      "type": "object",
      "additionalProperties": true
    },
    "ui": {
      "type": "object",
      "additionalProperties": true
    },
    "compile": {
      "type": "object",
      "required": ["compiled_at", "target_runtime", "validated"],
      "properties": {
        "compiled_at": { "type": "string" },
        "target_runtime": { "type": "string" },
        "validated": { "type": "boolean" },
        "signature": { "type": "string" },
        "source_format": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
