{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxcon.example/schemas/track.schema.json",
  "title": "Timeline Track",
  "type": "object",
  "required": ["id", "label", "type", "muted", "solo", "clips"],
  "properties": {
    "id": { "type": "string" },
    "label": { "type": "string" },
    "type": { "type": "string" },
    "color": { "type": "string" },
    "device_id": { "type": ["string", "null"] },
    "muted": { "type": "boolean" },
    "solo": { "type": "boolean" },
    "clips": {
      "type": "array",
      "items": { "$ref": "clip.schema.json" }
    },
    "automation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["parameter", "points"],
        "properties": {
          "parameter": { "type": "string" },
          "points": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["t_ms", "value"],
              "properties": {
                "t_ms": { "type": "integer" },
                "value": { "type": "number" },
                "easing": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
