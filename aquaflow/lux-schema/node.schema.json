{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxcon.example/schemas/node.schema.json",
  "title": "Show Graph Node",
  "type": "object",
  "required": ["id", "type", "label", "position", "ports", "params"],
  "properties": {
    "id": { "type": "string" },
    "type": { "type": "string" },
    "label": { "type": "string" },
    "position": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" }
      },
      "additionalProperties": false
    },
    "ports": {
      "type": "object",
      "properties": {
        "in": { "type": "array", "items": { "type": "string" } },
        "out": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "params": { "type": "object", "additionalProperties": true },
    "binding": {
      "type": "object",
      "properties": {
        "protocol": { "type": ["string", "null"] },
        "device_id": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
