{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxcon.example/schemas/clip.schema.json",
  "title": "Timeline Clip",
  "type": "object",
  "required": ["id", "start_ms", "end_ms", "label", "intensity", "behavior"],
  "properties": {
    "id": { "type": "string" },
    "start_ms": { "type": "integer", "minimum": 0 },
    "end_ms": { "type": "integer", "minimum": 0 },
    "label": { "type": "string" },
    "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
    "behavior": {
      "type": "object",
      "properties": {
        "preset_id": { "type": "string" },
        "easing": { "type": "string" },
        "blend": { "type": "string" },
        "loop": { "type": "boolean" },
        "parameters": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "safety_class": { "type": "string", "enum": ["normal", "critical", "inhibit", "rollback"] },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
