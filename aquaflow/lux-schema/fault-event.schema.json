{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxcon.example/schemas/fault-event.schema.json",
  "title": "Fault Event",
  "type": "object",
  "required": ["fault_id", "timestamp", "severity", "source", "message", "latched"],
  "properties": {
    "fault_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "severity": { "type": "string", "enum": ["info", "warning", "fault", "critical"] },
    "source": { "type": "string" },
    "message": { "type": "string" },
    "latched": { "type": "boolean" },
    "rollback_required": { "type": "boolean" },
    "safe_state_applied": { "type": "boolean" }
  },
  "additionalProperties": false
}
